local constants = require("@root/release/constants")

local function renderUnion(values: { string }): string
	local literals = {}
	for _, value in values do
		table.insert(literals, string.format("%q", value))
	end
	return table.concat(literals, " | ")
end

-- Renders `types.luau`, which entries require for the `Entry` type they
-- annotate their table with. luau-lsp then rejects a value `changewrite.toml`
-- doesn't allow while the entry is open in an editor. `categories` and `kinds` follow the same rules as
-- `parseUnreleasedChange`: a category is required only when the list is
-- configured, and an entry can only set a kind from a configured list.
local function renderEntryTypes(categories: { string }?, kinds: { string }): string
	local lines = {
		"-- Generated by `changewrite generate` from changewrite.toml. Don't edit it by hand.",
		"",
		'export type Bump = "major" | "minor" | "patch"',
	}
	if categories then
		table.insert(lines, `export type Category = {renderUnion(categories)}`)
	end
	if #kinds > 0 then
		table.insert(lines, `export type Kind = {renderUnion(kinds)}`)
	end
	table.insert(lines, `export type Flag = {renderUnion(constants.CHANGE_FLAGS)}`)

	table.insert(lines, "")
	table.insert(lines, "export type Entry = {")
	table.insert(lines, "\tbump: Bump,")
	table.insert(lines, if categories then "\tcategory: Category," else "\tcategory: string?,")
	if #kinds > 0 then
		table.insert(lines, "\tkind: Kind,")
	end
	table.insert(lines, "\tflags: { Flag }?,")
	table.insert(lines, "\thighlight: string?,")
	table.insert(lines, "\tpr: number?,")
	table.insert(lines, "\tsummary: string,")
	table.insert(lines, "\tdescription: string?,")
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "return nil")
	table.insert(lines, "")
	return table.concat(lines, "\n")
end

return renderEntryTypes
