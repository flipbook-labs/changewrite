-- Embeds the chip font in the CLI. `lute compile` bundles only Luau modules, so
-- the font travels as a base64 string module. Run this after replacing the font
-- file; a spec fails while the two differ.
local fs = require("@std/fs")

local base64 = require("@lpm/batteries@v1.0.1-nightly.20261115/base64")

local FONT_PATH = "workspace/chips/assets/font/SchibstedGrotesk-Bold.ttf"
local OUTPUT_PATH = "workspace/chips/src/fontData.luau"

local encoded = buffer.tostring(base64.encode(buffer.fromstring(fs.readFileToString(FONT_PATH))))
fs.writeStringToFile(
	OUTPUT_PATH,
	table.concat({
		`-- Generated by \`lute run embed-font\` from {FONT_PATH}. Don't edit by hand.`,
		"-- stylua: ignore",
		`return "{encoded}"`,
		"",
	}, "\n")
)
print(`Wrote {OUTPUT_PATH}.`)
